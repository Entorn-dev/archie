{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archie.dev/schemas/v1/scanner-manifest.schema.json",
  "title": "Archie scanner manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "executable", "arguments", "artifactGlobs", "capabilities", "configurationSchema", "permissions"],
  "properties": {
    "schemaVersion": { "const": "scanner-manifest/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "type": "string", "minLength": 1 },
    "executable": { "type": "string", "minLength": 1 },
    "arguments": { "type": "array", "items": { "type": "string" } },
    "artifactGlobs": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1 } },
    "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "configurationSchema": { "type": "object" },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readRepository", "network", "environment"],
      "properties": {
        "readRepository": { "const": true },
        "network": { "const": false },
        "environment": { "const": false }
      }
    }
  }
}
