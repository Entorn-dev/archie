{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archie.dev/schemas/v1/graph-snapshot.schema.json",
  "title": "Archie canonical graph snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "composition", "overlayDigest", "governanceDate", "nodes", "edges",
    "evidence", "mergeDecisions", "diagnostics", "redactions"
  ],
  "properties": {
    "schemaVersion": { "const": "architecture/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "inputs"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "observationBundleDigest"],
            "properties": {
              "repository": { "$ref": "common.schema.json#/$defs/repositoryRevision" },
              "observationBundleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "overlayDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "governanceDate": { "type": "string", "format": "date" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "resolution", "aliases", "properties", "evidenceIds"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "$ref": "common.schema.json#/$defs/nodeKind" },
          "name": { "type": "string", "minLength": 1 },
          "resolution": { "$ref": "common.schema.json#/$defs/resolution" },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "properties": { "$ref": "common.schema.json#/$defs/properties" },
          "evidenceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "from", "to", "confidence", "resolution", "provenance", "properties", "evidenceIds"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "$ref": "common.schema.json#/$defs/edgeKind" },
          "from": { "$ref": "common.schema.json#/$defs/id" },
          "to": { "$ref": "common.schema.json#/$defs/id" },
          "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
          "resolution": { "$ref": "common.schema.json#/$defs/resolution" },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/provenance" },
            "uniqueItems": true
          },
          "properties": { "$ref": "common.schema.json#/$defs/properties" },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/id" },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence" } },
    "mergeDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "candidateIds", "rationale"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "outcome": { "type": "string", "minLength": 1 },
          "candidateIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/diagnostic" } },
    "redactions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/redaction" } }
  }
}
