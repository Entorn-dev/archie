{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archie.dev/schemas/v1/saved-view.schema.json",
  "title": "Archie saved view v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "description", "layoutDirection", "selectedId", "pathQuery"],
  "properties": {
    "schemaVersion": { "const": "architecture-view/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "layoutDirection": { "enum": ["RIGHT", "DOWN"] },
    "selectedId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
    "pathQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "direction", "maxDepth", "edgeKinds"],
      "properties": {
        "from": { "$ref": "common.schema.json#/$defs/id" },
        "to": { "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
        "direction": { "enum": ["upstream", "downstream"] },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 12 },
        "edgeKinds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/edgeKind" }, "uniqueItems": true }
      }
    }
  }
}
