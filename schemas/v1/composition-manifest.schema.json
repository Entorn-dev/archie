{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archie.dev/schemas/v1/composition-manifest.schema.json",
  "title": "Archie project composition manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "inputs"],
  "properties": {
    "schemaVersion": { "const": "composition-manifest/v1" },
    "projectId": { "$ref": "common.schema.json#/$defs/id" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repositoryId", "observationPath", "observationBundleDigest"],
        "properties": {
          "repositoryId": { "$ref": "common.schema.json#/$defs/id" },
          "observationPath": { "type": "string", "minLength": 1 },
          "observationBundleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
